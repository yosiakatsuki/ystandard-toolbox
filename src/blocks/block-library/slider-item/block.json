{
	"$schema": "https://raw.githubusercontent.com/WordPress/gutenberg/trunk/schemas/json/block.json",
	"apiVersion": 3,
	"name": "ystdtb/slider-item",
	"version": "2.0.0",
	"title": "スライダーアイテム",
	"description": "スライダー内で任意のブロックを使うためのブロック",
	"parent": [ "ystdtb/slider" ],
	"category": "ystdtb-common",
	"keywords": [
		"スライダー",
		"slider"
	],
	"textdomain": "ystandard-toolbox",
	"selectors": {
		"root": ".ystdtb-slider-item"
	},
	"attributes": {
		"style": { "type": "object" }
	},
	"supports": {
		"anchor": false,
		"align": false,
		"className": false,
		"dimensions": {
			"width": true,
			"height": true,
			"__experimentalDefaultControls": {
				"width": false,
				"height": false
			},
			"__experimentalSkipSerialization": [ "width", "height" ]
		},
		"spacing": {
			"padding": true,
			"__experimentalDefaultControls": { "padding": false }
		}
	},
	"example": {},
	"editorScript": "file:./index.js",
	"editorStyle": ["ystdtb-aktk-components-editor", "file:./index.css"],
	"style": "file:./style-index.css"
}
