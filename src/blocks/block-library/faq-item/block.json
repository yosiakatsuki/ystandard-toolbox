{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ystdtb/faq-item",
	"version": "1.0.0",
	"title": "FAQアイテム",
	"category": "ystdtb-blocks",
	"description": "FAQブロックのQ&Aアイテム",
	"keywords": [
		"faq",
		"item",
		"Q&A"
	],
	"parent": [
		"ystdtb/faq"
	],
	"textdomain": "ystandard-toolbox",
	"attributes": {
		"faqType": {
			"type": "string",
			"default": "q"
		},
		"textColor": {
			"type": "string"
		},
		"backgroundColor": {
			"type": "string"
		},
		"gradient": {
			"type": "string"
		},
		"borderColor": {
			"type": "string"
		},
		"labelPosition": {
			"type": "string",
			"default": "center"
		},
		"fontSize": {
			"type": "string"
		},
		"labelSize": {
			"type": "string"
		},
		"customLabelSize": {
			"type": "string"
		},
		"labelColor": {
			"type": "string"
		},
		"customLabelColor": {
			"type": "string"
		},
		"labelBold": {
			"type": "boolean",
			"default": true
		},
		"labelBackgroundColor": {
			"type": "string"
		},
		"customLabelBackgroundColor": {
			"type": "string"
		},
		"labelBorderSize": {
			"type": "string"
		},
		"labelBorderRadius": {
			"type": "string"
		},
		"labelBorderColor": {
			"type": "string"
		},
		"customLabelBorderColor": {
			"type": "string"
		},
		"accordionArrowColor": {
			"type": "string"
		},
		"customAccordionArrowColor": {
			"type": "string"
		},
		"style": {
			"type": "object"
		}
	},
	"usesContext": [
		"ystdtb/isAccordion",
		"ystdtb/backgroundColor",
		"ystdtb/borderType",
		"ystdtb/borderSize",
		"ystdtb/borderColor",
		"ystdtb/customBorderColor",
		"ystdtb/accordionArrowColor",
		"ystdtb/customAccordionArrowColor"
	],
	"supports": {
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": false,
				"radius": false,
				"style": false,
				"width": false
			}
		},
		"color": {
			"text": true,
			"background": true,
			"gradients": true,
			"__experimentalSkipSerialization": [ "text" ]
		},
		"typography": {
			"fontSize": true,
			"__experimentalSkipSerialization": [ "fontSize" ],
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"align": false,
		"className": false,
		"reusable": false
	},
	"selectors": {
		"root": ".ystdtb-faq-item",
		"color": {
			"root": ".ystdtb-faq-item",
			"text": ".ystdtb-faq-item__contents"
		},
		"typography": ".ystdtb-faq-item__contents"
	},
	"editorScript": "file:./index.js",
	"editorStyle": ["ystdtb-aktk-components-editor", "file:./index.css"],
	"style": "file:./style-index.css"
}
