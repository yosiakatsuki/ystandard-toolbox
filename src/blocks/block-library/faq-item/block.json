{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ystdtb/faq-item",
	"version": "1.0.0",
	"title": "FAQアイテム",
	"category": "ystdtb-blocks",
	"description": "FAQブロックのQ&Aアイテム",
	"keywords": [
		"faq",
		"item",
		"Q&A"
	],
	"parent": [
		"ystdtb/faq"
	],
	"textdomain": "ystandard-toolbox",
	"attributes": {
		"faqType": {
			"type": "string",
			"default": "q"
		},
		"textColor": {
			"type": "string"
		},
		"backgroundColor": {
			"type": "string"
		},
		"gradient": {
			"type": "string"
		},
		"borderColor": {
			"type": "string"
		},
		"fontSize": {
			"type": "string"
		},
		"style": {
			"type": "object"
		}
	},
	"usesContext": [
		"ystdtb/isAccordion",
		"ystdtb/backgroundColor",
		"ystdtb/borderType",
		"ystdtb/borderSize",
		"ystdtb/borderColor",
		"ystdtb/customBorderColor"
	],
	"supports": {
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": false,
				"radius": false,
				"style": false,
				"width": false
			}
		},
		"color": {
			"text": true,
			"background": true,
			"gradients": true,
			"__experimentalSkipSerialization": [
				"text"
			],
			"__experimentalDefaultControls": {
				"text": false,
				"background": false,
				"gradients": false
			}
		},
		"typography": {
			"fontSize": true,
			"__experimentalSkipSerialization": [
				"fontSize"
			],
			"__experimentalDefaultControls": {
				"fontSize": false
			}
		},
		"align": false,
		"className": false,
		"reusable": false,
		"spacing": {
			"padding": true,
			"__experimentalSkipSerialization": [
				"padding"
			],
			"__experimentalDefaultControls": {
				"padding": false
			}
		}
	},
	"selectors": {
		"root": ".ystdtb-faq-item",
		"color": {
			"root": ".ystdtb-faq-item",
			"text": ".ystdtb-faq-item__contents"
		},
		"typography": ".ystdtb-faq-item__contents",
		"spacing": ".ystdtb-faq-item__contents"
	},
	"editorScript": "file:./index.js",
	"editorStyle": [
		"ystdtb-aktk-components-editor",
		"file:./index.css"
	],
	"style": "file:./style-index.css"
}
