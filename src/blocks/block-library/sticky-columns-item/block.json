{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ystdtb/sticky-columns-item",
	"version": "0.1.0",
	"title": "片方が追従できるカラム（子）",
	"category": "ystdtb",
	"description": "片方が追従できるカラムの中に配置するカラムです。",
	"textdomain": "ystandard-toolbox",
	"parent": [ "ystdtb/sticky-columns" ],
	"selectors": {
		"root": ".ystdtb-sticky-columns-item"
	},
	"attributes": {
		"fontSize": {
			"type": "string"
		},
		"textColor": {
			"type": "string"
		},
		"backgroundColor": {
			"type": "string"
		},
		"gradient": {
			"type": "string"
		},
		"borderColor": {
			"type": "string"
		},
		"style": {
			"type": "object"
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"className": false,
		"customClassName": false,
		"reusable": false,
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalDefaultControls": {
				"fontSize": false,
				"lineHeight": false
			}
		},
		"color": {
			"text": true,
			"background": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"text": false,
				"background": false,
				"gradients": false
			}
		},
		"spacing": {
			"padding": true,
			"margin": [ "top", "bottom" ],
			"__experimentalDefaultControls": {
				"padding": false,
				"margin": false
			}
		},
		"__experimentalBorder": {
			"color": true,
			"width": true,
			"style": true,
			"radius": true,
			"__experimentalDefaultControls": {
				"color": false,
				"width": false,
				"style": false,
				"radius": false,
				"shadow": false
			}
		},
		"shadow": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
