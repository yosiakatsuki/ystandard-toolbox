{
	"patterns": [
		{
			"id": "desktop-only",
			"label": "PCのみ",
			"devices": [ "desktop" ]
		},
		{
			"id": "tablet-only",
			"label": "タブレットのみ",
			"devices": [ "tablet" ]
		},
		{
			"id": "mobile-only",
			"label": "モバイルのみ",
			"devices": [ "mobile" ]
		},
		{
			"id": "all-devices",
			"label": "PC・タブレット・モバイル全部指定",
			"devices": [ "desktop", "tablet", "mobile" ]
		},
		{
			"id": "tablet-mobile",
			"label": "タブレット・モバイルの2つ指定",
			"devices": [ "tablet", "mobile" ]
		}
	],
	"settings": [
		{
			"id": "faq-font-size",
			"label": "親FAQ文字サイズ",
			"blockName": "ystdtb/faq",
			"element": "root",
			"normalPath": "style.typography.fontSize",
			"normal": "16px",
			"responsivePath": "style.ystdtb.faq.responsive.typography.fontSize",
			"values": {
				"desktop": "22px",
				"tablet": "20px",
				"mobile": "18px"
			},
			"variables": {
				"font-size": "faq--font-size"
			}
		},
		{
			"id": "faq-margin",
			"label": "親FAQ外側余白",
			"blockName": "ystdtb/faq",
			"element": "root",
			"normalPath": "style.spacing.margin",
			"normal": {
				"top": "6px",
				"bottom": "8px"
			},
			"responsivePath": "style.ystdtb.faq.responsive.spacing.margin",
			"values": {
				"desktop": {
					"top": "12px",
					"bottom": "16px"
				},
				"tablet": {
					"top": "10px",
					"bottom": "14px"
				},
				"mobile": {
					"top": "8px",
					"bottom": "12px"
